API_URL = "https://play.formal-methods.net/"
REDIS_URL = "redis://localhost:6379/0"
CACHE_TTL = 3600
EXTENDED_CACHE_TTL = 86400

# Per solver call (ms); a call that runs out yields "unknown". Requests may override up to the max.
SMT_DIFF_SOLVER_TIMEOUT_MS = 10000
SMT_DIFF_MAX_SOLVER_TIMEOUT_MS = 60000
# Whole /analyze (or semantic-relation) request (s); the worker process is killed after it.
SMT_DIFF_REQUEST_TIMEOUT_S = 60
SMT_DIFF_MAX_REQUEST_TIMEOUT_S = 300
